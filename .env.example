NODE_ENV=development
PORT=4015
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/socketfi_history?schema=public

# Required by all /v1 endpoints. Rotate by temporarily supplying old,new.
APP_API_KEYS=replace-with-a-random-secret-of-at-least-32-characters

TESTNET_RPC_URL=https://soroban-testnet.stellar.org
PUBLIC_RPC_URL=https://your-mainnet-rpc.example.com
TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
PUBLIC_HORIZON_URL=https://horizon.stellar.org

TESTNET_FACTORY_CONTRACT_ID=C...
PUBLIC_FACTORY_CONTRACT_ID=C...

# Any funded G-account is sufficient for read-only token symbol/decimals simulations.
TESTNET_SIMULATION_SOURCE=G...
PUBLIC_SIMULATION_SOURCE=G...

POLL_INTERVAL_MS=5000
TX_PAGE_LIMIT=200
EVENT_PAGE_LIMIT=1000
START_LEDGER_TESTNET=
START_LEDGER_PUBLIC=
CORS_ORIGIN=http://localhost:5173
PRICE_QUOTE_ASSET=USDC
PRICE_CACHE_SECONDS=300
